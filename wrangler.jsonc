{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "is-there-a-cve-today",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-19",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "isthereacvetoday.com",
      "custom_domain": true,
      "enabled": true,
      "previews_enabled": false
    }
  ],
  "send_metrics": false,
  "rules": [{ "type": "Text", "globs": ["**/*.css"], "fallthrough": true }],
  "triggers": {
    "crons": ["*/30 * * * *"]
  },
  "kv_namespaces": [{ "binding": "CVE_STATUS" }],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
